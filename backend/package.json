{
  "name": "presensiku-backend",
  "version": "1.0.0",
  "private": true,
  "description": "PresensiKu backend: API gateway + auth, employee and attendance microservices",
  "scripts": {
    "build": "nest build auth-service && nest build employee-service && nest build attendance-service && nest build gateway",
    "start:dev": "concurrently -k -n auth,employee,attendance,gateway -c blue,magenta,cyan,green \"npm:dev:auth\" \"npm:dev:employee\" \"npm:dev:attendance\" \"npm:dev:gateway\"",
    "dev:auth": "nest start auth-service --watch",
    "dev:employee": "nest start employee-service --watch",
    "dev:attendance": "nest start attendance-service --watch",
    "dev:gateway": "nest start gateway --watch",
    "start:prod": "concurrently -k -n auth,employee,attendance,gateway \"node dist/apps/auth-service/main\" \"node dist/apps/employee-service/main\" \"node dist/apps/attendance-service/main\" \"node dist/apps/gateway/main\"",
    "db:setup": "ts-node -r tsconfig-paths/register database/setup.ts",
    "seed": "ts-node -r tsconfig-paths/register database/seed.ts",
    "lint": "eslint \"{apps,libs,database}/**/*.ts\"",
    "format": "prettier --write \"{apps,libs,database}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/microservices": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.5",
    "mysql2": "^3.11.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0"
  }
}
